# Required: copy the Session pooler URL from Supabase Dashboard > Connect.
# Keep port 5432. Replace only the placeholders and URL-encode reserved
# characters in the database password. Never commit backend/.env.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-POOLER_INDEX-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Optional backend settings. These defaults are for local development.
FRONTEND_ORIGIN=http://localhost:5173
SESSION_COOKIE_SECURE=false
